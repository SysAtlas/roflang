extern putchar(i32) -> i32;

def print_int(x: i32) -> void {
  n: i32 = x;
  divisor: i32 = 1;

  if (n == 0) {
    putchar(48);
    return;
  }

  while (n / divisor >= 10) {
    divisor = divisor * 10;
  }

  while (divisor > 0) {
    digit: i32 = n / divisor;
    putchar(digit + 48);

    n = n - digit * divisor;
    divisor = divisor / 10;
  }

  return;
}

def main() -> i32 {
    n: i32 = 1000000;
    number: i32 = 2;
    divisor: i32 = 2;
    prime: i32 = 1;

    while (number <= n) {
        divisor = 2;
        prime = 1;

        while (divisor * divisor <= number) {
            if (number % divisor == 0) {
                prime = 0;
            }

            divisor = divisor + 1;
        }

        if (prime == 1) {
            print_int(number);
            putchar(10);
        }

        number = number + 1;
    }

    return 0;
}